	<GeneDef ParentName="PA_GeneVoiceBase" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PA_Gene_VoiceLoraptora</defName>
		<label>loraptora voice</label>
		<description>Carriers sound like a loraptora.</description>
		<iconPath>UI/Icons/Genes/Gene_VoiceHuman</iconPath>
		<displayOrderInCategory>160</displayOrderInCategory>
		<soundCall>PA_Loraptora_Call</soundCall>
		<soundWounded>PA_Loraptora_Wounded</soundWounded>
		<soundDeath>PA_Loraptora_Death</soundDeath>
		<symbolPack>
			<wholeNameSymbols>
				<li><symbol>trillfang</symbol></li>
				<li><symbol>chitterer</symbol></li>
				<li><symbol>swiftjaw</symbol></li>
			</wholeNameSymbols>
			<prefixSymbols>
				<li><symbol>trill</symbol></li>
				<li><symbol>skree</symbol></li>
				<li><symbol>lora</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>chit</symbol></li>
				<li><symbol>claw</symbol></li>
				<li><symbol>trill</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

