<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="PA_AnimalBase">
		<defName>PA_Mudlurker</defName>
		<label>mudlurker</label>
		<description>A solitary browser of swamps and bogs. Known to defend itself with its flat heavy tail and thick thumb spikes. It likes to catch and hoard fish. It grazes on ordinary plants otherwise.</description>
		<statBases>
			<MoveSpeed>3.9</MoveSpeed>
			<MarketValue>300</MarketValue>
			<ComfyTemperatureMin>-25</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
			<Wildness>0.6</Wildness>
			<FilthRate>10</FilthRate>
		</statBases>
		<tools>
			<li>
				<label>tail slap</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>16</power>
				<cooldownTime>2.4</cooldownTime>
				<linkedBodyPartsGroup>PA_TailClub</linkedBodyPartsGroup>
			</li>
			<li>
				<label>thumb spikes</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>11</power>
				<cooldownTime>1.8</cooldownTime>
				<linkedBodyPartsGroup>PA_ThumbSpikes</linkedBodyPartsGroup>
			</li>
			<li>
				<label>teeth</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2.2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggFertilizedDef>PA_EggMudlurkerFertilized</eggFertilizedDef>
				<eggUnfertilizedDef>PA_EggMudlurkerUnfertilized</eggUnfertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>8</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~2</eggCountRange>
			</li>
			<li Class="ProjectArcos.CompProperties_HoardCaster">
				<ability>PA_CraftCache</ability>
				<initialCooldownRange>2500~30000</initialCooldownRange>
			</li>
		</comps>
		<race>
			<body>PA_TheropodBodyWithArms</body>
			<baseBodySize>1.6</baseBodySize>
			<baseHealthScale>1.0</baseHealthScale>
			<baseHungerRate>0.3</baseHungerRate>
			<herdAnimal>true</herdAnimal>
			<herdMigrationAllowed>false</herdMigrationAllowed>
			<waterSeeker>true</waterSeeker>
			<foodType>VegetarianRoughAnimal</foodType>
			<useMeatFrom>PA_Nightgorger</useMeatFrom>
			<trainability>Intermediate</trainability>
			<specialTrainables>
